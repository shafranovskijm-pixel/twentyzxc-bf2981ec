            "document"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "crm_revise_document",
        "title": "Изменить дату, стоимость или скидку",
        "description": "Создаёт новую версию документа, созданного API. Сохраняет старую версию и реквизиты. Передайте актуальный expectedRevision; конфликт требует перечитать документ. services заменяет весь список услуг. discount:null убирает скидку. Повторная отправка пока не подключена.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "format": "uuid"
            },
            "documentId": {
              "$ref": "#/properties/requestId"
            },
            "expectedRevision": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "changes": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string"
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "qty": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "price": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "name",
                      "qty",
                      "price"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 100
                },
                "subject": {
                  "type": "string"
                },
                "deadline": {
                  "type": "string"
                },
                "paymentTerms": {
                  "type": "string"
                },
                "servicePeriod": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string"
                    },
                    "end": {
                      "type": "string"
                    },
                    "noDeadline": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "noDeadline"
                  ],
                  "additionalProperties": false
                },
                "discount": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "amount",
                            "percent"
                          ]
                        },
                        "value": {
                          "type": "number",
                          "minimum": 0
                        },
                        "deadline": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
