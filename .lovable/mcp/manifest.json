                  "description": "Период или срок услуг договора, как согласовал пользователь."
                },
                "paymentTerms": {
                  "type": "string"
                },
                "contractId": {
                  "$ref": "#/properties/requestId"
                },
                "discount": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "amount",
                        "percent"
                      ]
                    },
                    "value": {
                      "type": "number",
                      "minimum": 0
                    },
                    "deadline": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "servicePeriod": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string"
                    },
                    "end": {
                      "type": "string"
                    },
                    "noDeadline": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "noDeadline"
                  ],
                  "additionalProperties": false,
                  "description": "Явные даты периода услуг договора YYYY-MM-DD; отдельно от даты договора и даты оплаты. Должны соответствовать тексту deadline."
                }
              },
              "required": [
                "type",
                "clientId",
                "date",
                "number",
                "services"
              ],
              "additionalProperties": false
            }
          },
          "required": [
