        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "format": "uuid"
            },
            "document": {
              "type": "object",
